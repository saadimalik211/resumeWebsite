---
import { resume } from "../data/resume";
---

<section id="experience" class="section">
  <div class="container">
    <h2 class="section-title fade-in">Experience</h2>
    <div class="timeline">
      {
        resume.experience.map((job) => (
          <article class="timeline-item fade-in">
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-content">
              <header class="timeline-header">
                <div>
                  <h3 class="job-title">{job.title}</h3>
                  <p class="job-company">
                    {job.company} · {job.location}
                  </p>
                </div>
                <time class="job-period">{job.period}</time>
              </header>
              <ul class="job-highlights">
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
              {job.tools && (
                <p class="job-tools">
                  <span class="job-tools-label">Tools:</span>{" "}
                  {job.tools.join(" · ")}
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: 1.5rem;
    padding-left: 0;
  }

  .timeline-marker {
    width: 0.875rem;
    height: 0.875rem;
    margin-top: 0.375rem;
    background: var(--color-accent);
    border: 2px solid var(--color-bg);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--color-accent-subtle);
    z-index: 1;
  }

  .timeline-content {
    padding: 1.5rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .timeline-content:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .job-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  .job-company {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .job-period {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--color-accent);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .job-highlights {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    color: var(--color-text-muted);
  }

  .job-highlights li {
    margin-bottom: 0.5rem;
  }

  .job-highlights li:last-child {
    margin-bottom: 0;
  }

  .job-tools {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .job-tools-label {
    color: var(--color-text);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .timeline-header {
      flex-direction: column;
      gap: 0.5rem;
    }

    .job-period {
      white-space: normal;
    }
  }
</style>
