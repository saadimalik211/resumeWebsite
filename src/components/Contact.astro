---
import { resume } from "../data/resume";
---

<section id="contact" class="section contact">
  <div class="container">
    <h2 class="section-title fade-in">Contact</h2>
    <div class="contact-card fade-in">
      <p class="contact-text">
        Interested in working together? Reach out — I'd love to connect.
      </p>
      <div class="contact-links">
        <a href={`mailto:${resume.email}`} class="contact-link">
          {resume.email}
        </a>
        <a href={`tel:${resume.phone.replace(/-/g, "")}`} class="contact-link">
          {resume.phone}
        </a>
        {
          resume.links.map((link) => (
            <a
              href={link.url}
              class="contact-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <p>
      &copy; {new Date().getFullYear()} {resume.name}. Built with Astro +
      TypeScript.
    </p>
  </div>
</footer>

<style>
  .contact {
    padding-bottom: 2rem;
  }

  .contact-card {
    padding: 2rem;
    text-align: center;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .contact-text {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .contact-link {
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    background: var(--color-accent-subtle);
    transition: background var(--transition);
  }

  .contact-link:hover {
    background: var(--color-accent);
    color: #fff;
  }

  .footer {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .footer p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
