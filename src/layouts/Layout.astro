---
import "../styles/global.css";
import { resume } from "../data/resume";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${resume.name} — ${resume.title}`,
  description = `Resume and portfolio of ${resume.name}, ${resume.title} based in ${resume.location}.`,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <footer class="visitor-footer">
      <span id="visitor-count">—</span> visitors
    </footer>
    <script>
      const COUNT_URL = "https://worker.gensosekai.workers.dev";
      const SESSION_KEY = "visitor-counted";
      const SESSION_ID_KEY = "visitor-session-id";

      function getOrCreateSessionId(): string {
        let sessionId = sessionStorage.getItem(SESSION_ID_KEY);
        if (!sessionId) {
          sessionId = `${Date.now()}-${Math.random().toString(36).substring(2, 15)}`;
          sessionStorage.setItem(SESSION_ID_KEY, sessionId);
        }
        return sessionId;
      }

      async function loadVisitorCount() {
        const alreadyCounted = sessionStorage.getItem(SESSION_KEY) === "1";
        const sessionId = getOrCreateSessionId();
        
        const res = await fetch(COUNT_URL, {
          method: alreadyCounted ? "GET" : "POST",
          headers: {
            "X-Session-ID": sessionId,
          },
        });
        if (!res.ok) return;
        const data: unknown = await res.json();
        if (
          typeof data !== "object" ||
          data === null ||
          !("count" in data) ||
          typeof (data as { count: unknown }).count !== "number"
        ) {
          return;
        }
        if (!alreadyCounted) sessionStorage.setItem(SESSION_KEY, "1");
        const el = document.getElementById("visitor-count");
        if (el) el.textContent = (data as { count: number }).count.toLocaleString();
      }

      loadVisitorCount().catch(() => {
        // Keep the placeholder if the Worker is unreachable.
      });
    </script>
  </body>
</html>